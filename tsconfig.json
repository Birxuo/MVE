{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["services/*/src/**/*.ts", "voting/*/src/**/*.ts", "apps/*/src/**/*.ts", "research/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
